[Desktop Entry]
Name=Huawei FusionSolar
Comment=Shows live PV power, battery charge and today's yield from Huawei FusionSolar
Icon=weather-clear
Type=Service
X-KDE-ServiceTypes=Plasma/Applet
X-Plasma-API=declarativeappletscript
X-Plasma-MainScript=ui/main.qml
X-Plasma-API-Minimum-Version=6.0
X-KDE-PluginInfo-Name=huawei-fusionsolar-widget
X-KDE-PluginInfo-Author=GoitontheFloor
X-KDE-PluginInfo-Email=your-email@example.com
X-KDE-PluginInfo-Version=0.2.0
X-KDE-PluginInfo-Website=https://github.com/GoitontheFloor/huawei-fusionsolar-widget
X-KDE-PluginInfo-Category=System Information
X-KDE-PluginInfo-License=GPL-3.0-or-later
X-KDE-PluginInfo-EnabledByDefault=true
